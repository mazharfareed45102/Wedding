# Copy this file to .env.local and fill in your keys.
# Without any keys the app runs in DEMO MODE with sample designs.

# --- Required for the AI interior designer (photo analysis + design plans) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Required for the photorealistic "after" pictures (set at least one) ---
# Google Gemini image model ("Nano Banana"): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI GPT Image: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional settings ---
# Which image provider to use when both keys are set: gemini | openai (default: gemini)
# IMAGE_PROVIDER=gemini
# Override the image model names if your account uses different ones.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium
# Claude model and effort used for the design analysis.
# DESIGNER_MODEL=claude-opus-5-5
# DESIGNER_EFFORT=medium

# Protect your deployed app so strangers can't spend your API credits.
# When set, visitors must enter this passcode before designing.
# APP_PASSCODE=
